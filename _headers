# Cloudflare Pages custom headers
# Force revalidation on shared scripts/stylesheets/data files so edits
# reach visitors on their very next page load instead of sitting in
# Cloudflare's edge cache (default ~4h) or the browser's own cache.

/js/nav.js
  Cache-Control: no-cache

/js/sidebar.js
  Cache-Control: no-cache

/js/copy-prompt.js
  Cache-Control: no-cache

/css/style.css
  Cache-Control: no-cache

/js/curriculum/*
  Cache-Control: no-cache

/js/quiz.js
  Cache-Control: no-cache

/js/quiz-submit.js
  Cache-Control: no-cache

/js/cert-card.js
  Cache-Control: no-cache

/js/toolkit.js
  Cache-Control: no-cache

/js/slides-card.js
  Cache-Control: no-cache

/js/firebase-config.js
  Cache-Control: no-cache

/js/certificate.js
  Cache-Control: no-cache

/js/certificates/*
  Cache-Control: no-cache

# Downloadable files: save as attachments, cache for an hour, keep out of search results
/downloads/*
  Content-Disposition: attachment
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex
